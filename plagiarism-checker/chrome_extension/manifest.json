{
  "manifest_version": 3,
  "name": "TextTrace EDU - анализ документов",
  "version": "1.1.0",
  "description": "DOC/DOCX analyzer with server-side shingle comparison, IndexedDB history, VK buttons and activity tracking.",
  "action": {
    "default_title": "TextTrace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3100/*",
    "https://vk.com/*",
    "https://*.vk.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*"
      ],
      "js": [
        "js/content/vk-doc-checker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content/activity-tracker.js"
      ],
      "run_at": "document_idle"
    }
  ]
}